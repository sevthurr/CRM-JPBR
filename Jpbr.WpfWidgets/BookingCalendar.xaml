<UserControl x:Class="Jpbr.WpfWidgets.BookingCalendar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Colors -->
        <SolidColorBrush x:Key="AvailableColor" Color="#FFE6C268"/>
        <SolidColorBrush x:Key="BookedColor" Color="#FF3CB371"/>
        <SolidColorBrush x:Key="ClosedColor" Color="#FFE74C3C"/>
        <SolidColorBrush x:Key="SelectedBorderColor" Color="#FF3498DB"/>
        <SolidColorBrush x:Key="HeaderBackground" Color="#FFEDF6F9"/>
        
        <!-- Toggle Switch Style -->
        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Border x:Name="BackgroundBorder" Width="40" Height="20" CornerRadius="10" Background="#DDDDDD"/>
                            <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="White" HorizontalAlignment="Left" Margin="2,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="BackgroundBorder" Property="Background" Value="#E74C3C"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="22,0,0,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="White">
        <Border BorderBrush="#EAEAEA" BorderThickness="1" CornerRadius="8" Margin="10">
            <Grid>
                <!-- Main Grid with proper spacing -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header -->
                    <RowDefinition Height="Auto"/> <!-- Legend -->
                    <RowDefinition Height="Auto"/> <!-- Day headers -->
                    <RowDefinition Height="*"/> <!-- Calendar grid -->
                </Grid.RowDefinitions>

                <!-- Calendar Header -->
                <Grid Grid.Row="0" Margin="30,25,30,5">
                    <TextBlock x:Name="CalendarHeader" Text="October 2025" 
                           FontFamily="Poppins" FontSize="22" FontWeight="Bold" 
                           HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="PrevButton" Content="&lt;" Width="35" Height="35" Margin="0,0,10,0" 
                            Background="White" BorderBrush="#EAEAEA"
                            FontFamily="Poppins" FontSize="16" FontWeight="SemiBold"
                            Click="PrevButton_Click"/>
                        <Button x:Name="NextButton" Content="&gt;" Width="35" Height="35" 
                            Background="White" BorderBrush="#EAEAEA" 
                            FontFamily="Poppins" FontSize="16" FontWeight="SemiBold"
                            Click="NextButton_Click"/>
                    </StackPanel>
                </Grid>

                <!-- Legend -->
                <Border Grid.Row="1" Background="{StaticResource HeaderBackground}" Margin="30,5,30,10" Padding="15,8">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,40,0">
                            <Ellipse Width="15" Height="15" Fill="{StaticResource AvailableColor}" VerticalAlignment="Center"/>
                            <TextBlock Text="Available" Margin="10,0,0,0" FontFamily="Poppins" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,40,0">
                            <Ellipse Width="15" Height="15" Fill="{StaticResource BookedColor}" VerticalAlignment="Center"/>
                            <TextBlock Text="Booked" Margin="10,0,0,0" FontFamily="Poppins" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="15" Height="15" Fill="{StaticResource ClosedColor}" VerticalAlignment="Center"/>
                            <TextBlock Text="Closed" Margin="10,0,0,0" FontFamily="Poppins" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Calendar Days Header - Evenly spaced -->
                <Grid Grid.Row="2" Margin="30,5,30,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" Text="SU" FontFamily="Poppins" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="MO" FontFamily="Poppins" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="TU" FontFamily="Poppins" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="WE" FontFamily="Poppins" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="4" Text="TH" FontFamily="Poppins" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="5" Text="FR" FontFamily="Poppins" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="6" Text="SA" FontFamily="Poppins" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                </Grid>
                
                <!-- Calendar Grid - Use all available space -->
                <Grid Grid.Row="3" Margin="30,5,30,20">
                    <ItemsControl x:Name="CalendarGrid">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="6" Columns="7"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
